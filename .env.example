# ============================================================
# AI 聊天网站环境变量示例
# 使用方法： cp .env.example .env  （Windows: copy .env.example .env）
# 然后按实际情况修改。.env 已在 .gitignore 中，不会被提交。
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=aido
POSTGRES_PASSWORD=请替换为强密码_例如_随机32位字符串
POSTGRES_DB=aido
# 宿主机映射端口（默认即可，被占用时修改）
DB_PORT=5432

# ---------- 后端服务 ----------
BACKEND_PORT=4000
FRONTEND_PORT=8080
# JWT 签名密钥：务必使用随机长字符串（可用：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"）
JWT_SECRET=请替换为随机字符串
JWT_EXPIRES_IN=7d
# 允许跨域访问后端的来源（容器内由 nginx 同源代理，一般无需改动；本地 npm run dev 开发时保留第二项）
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# ---------- AI 模型（OpenAI 兼容接口） ----------
# 任何兼容 OpenAI Chat Completions 协议的服务均可：
#   OpenAI:          https://api.openai.com/v1
#   DeepSeek:        https://api.deepseek.com/v1
#   Moonshot(Kimi):  https://api.moonshot.cn/v1
#   本地 vLLM/Ollama: http://host.docker.internal:11434/v1 （Ollama 需开启 OpenAI 兼容端口）
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=在此填入你的模型服务密钥
AI_MODEL=gpt-4o-mini
# 无密钥演示模式：true 时后端不调用真实模型，返回模拟流式回复（默认 false）
AI_MOCK_MODE=false

# ---------- 可选：本地裸机开发用 ----------
# docker compose 启动时 DATABASE_URL 会自动生成，无需填写；
# 仅当不用 Docker、直接 npm run dev 启动后端时，才需要取消注释：
# DATABASE_URL=postgres://aido:密码@localhost:5432/aido
